{
  "name": "dls-core",
  "version": "0.2.0",
  "description": "DLS Core — Design Language System : tokens + composants génériques React, réutilisable sur tous les projets.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vincenthouin/dls-core.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./components.css": "./styles/components.css",
    "./tailwind-preset": "./tokens/tailwind-preset.cjs",
    "./tokens.json": "./tokens/tokens.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup"
  }
}
